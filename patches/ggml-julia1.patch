+// julia1 patch P6-P9: the fused epilogues read and write float4 runs
+static bool ggml_metal_fusion_aligned(const ggml_tensor * t, ggml_metal_fusion_mode mode) {
+    return mode != GGML_METAL_FUSION_FULL || ((uintptr_t) t->data) % 16 == 0;
+}
+
+// julia1 patch P6-P9: the fused kernel reads the activations (src1 of the MUL_MAT) until its last threadgroup finishes,
+// so a tensor it writes must not overlap them. The generic memory-range check lets a source that starts at the output's
+// address through (the write-through case of other fusions), so this is checked here, in FULL mode.
+static bool ggml_metal_fusion_mul_mat_writes_ok(const ggml_tensor * mm, const ggml_tensor * out, ggml_metal_fusion_mode mode) {
+    const ggml_tensor * x = mm->src[1];
+    if (mode != GGML_METAL_FUSION_FULL) {
+        return true;
+    }
+
+    ggml_backend_buffer_t bx = x->view_src ? x->view_src->buffer : x->buffer;
+    ggml_backend_buffer_t bo = out->view_src ? out->view_src->buffer : out->buffer;
+    if (bx != bo) {
+        return true;
+    }
+
+    const char * x0 = (const char *) x->data;
+    const char * o0 = (const char *) out->data;
+
+    return x0 + ggml_nbytes(x) <= o0 || o0 + ggml_nbytes(out) <= x0;
+}
+
+// julia1 patch P6-P9: a MUL_MAT whose output only feeds the fused node, and that ggml_metal_op_mul_mat runs on the legacy
+// simdgroup kernel_mul_mm (F32/F16 weights, more than 8 F32 columns, 2-D, no output bounds checks), the only kernel
+// with the fused epilogues. FULL mode also checks the device (no Metal-4 tensor API, simdgroup matrices).
+static bool ggml_metal_fusion_check_mul_mat_epi(const ggml_tensor * mm, ggml_metal_fusion_mode mode) {
+    const ggml_tensor * w = mm->src[0];
+    const ggml_tensor * x = mm->src[1];
+
+    if (mm->op != GGML_OP_MUL_MAT || ggml_metal_op_mul_mat_use_fwht(mm) ||
+        (w->type != GGML_TYPE_F32 && w->type != GGML_TYPE_F16) || x->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32 ||
+        ggml_is_transposed(w) || ggml_is_transposed(x) || w->ne[0] < 64 || x->ne[1] <= 8 ||
+        x->ne[2] != 1 || x->ne[3] != 1 || mm->ne[0] % 64 != 0 || mm->ne[1] % 32 != 0) {
+        return false;
+    }
+
+    if (mode == GGML_METAL_FUSION_FULL) {
+        ggml_backend_buffer_t buf = mm->view_src ? mm->view_src->buffer : mm->buffer;
+        if (!buf || !buf->buft || !buf->buft->device) {
+            return false;
+        }
+
+        const ggml_metal_device_props * props = ggml_metal_device_get_props((ggml_metal_device_t) buf->buft->device->context);
+        if (props->has_tensor || !props->has_simdgroup_mm) {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+// julia1 patch P6: MUL_MAT + ADD, the other addend (the residual) has the layout of the output
+static bool ggml_metal_fusion_check_mul_mat_add(
+        const ggml_metal_fusion      * fusion,
+        const ggml_tensor * const    * nodes,
+        const ggml_cgraph            * gf,
+        const int                    * node_idxs,
+              int                      idx,
+              ggml_metal_fusion_mode   mode) {
+    GGML_UNUSED(fusion);
+    GGML_UNUSED(gf);
+    GGML_UNUSED(node_idxs);
+    GGML_UNUSED(idx);
+
+    const ggml_tensor * mm  = nodes[0];
+    const ggml_tensor * add = nodes[1];
+    const ggml_tensor * res = add->src[0] == mm ? add->src[1] : add->src[0];
+
+    return ggml_metal_fusion_check_mul_mat_epi(mm, mode) && res != mm && res->type == GGML_TYPE_F32 &&
+           add->type == GGML_TYPE_F32 && ggml_is_contiguous(res) && ggml_is_contiguous(add) && ggml_are_same_shape(res, add) &&
+           ggml_metal_fusion_aligned(res, mode) && ggml_metal_fusion_aligned(add, mode) &&
+           ggml_metal_fusion_mul_mat_writes_ok(mm, add, mode);
+}
+
+// julia1 patch P7: MUL_MAT + GLU (geglu_erf of the first half by the second half of the MUL_MAT output rows)
+static bool ggml_metal_fusion_check_mul_mat_geglu(
+        const ggml_metal_fusion      * fusion,
+        const ggml_tensor * const    * nodes,
+        const ggml_cgraph            * gf,
+        const int                    * node_idxs,
+              int                      idx,
+              ggml_metal_fusion_mode   mode) {
+    const ggml_tensor * mm  = nodes[0];
+    const ggml_tensor * glu = nodes[1];
+
+    if (glu->op != GGML_OP_GLU || ggml_get_glu_op(glu) != GGML_GLU_OP_GEGLU_ERF || glu->src[0] != mm || glu->src[1] ||
+        ggml_get_op_params_i32(glu, 1) != 0 || glu->type != GGML_TYPE_F32 || !ggml_is_contiguous(glu) ||
+        glu->ne[0] != mm->ne[0]/2 || glu->ne[1] != mm->ne[1] || !ggml_metal_fusion_check_mul_mat_epi(mm, mode) ||
+        !ggml_metal_fusion_aligned(glu, mode) || !ggml_metal_fusion_mul_mat_writes_ok(mm, glu, mode)) {
+        return false;
+    }
+
+    const int outputs[1] = { node_idxs[idx + 1] };
+
+    return ggml_can_fuse_subgraph_ext(gf, node_idxs + idx, 2, fusion->ops.data(), outputs, 1);
+}
+
+// julia1 patch P8: MUL_MAT + ADD (bias vector) [+ ADD (residual, the layout of the output) | UNARY (relu)]
+static bool ggml_metal_fusion_check_mul_mat_bias(
+        const ggml_metal_fusion      * fusion,
+        const ggml_tensor * const    * nodes,
+        const ggml_cgraph            * gf,
+        const int                    * node_idxs,
+              int                      idx,
+              ggml_metal_fusion_mode   mode) {
+    GGML_UNUSED(gf);
+    GGML_UNUSED(node_idxs);
+    GGML_UNUSED(idx);
+
+    const ggml_tensor * mm   = nodes[0];
+    const ggml_tensor * add  = nodes[1];
+    const ggml_tensor * bias = add->src[1];
+
+    if (!ggml_metal_fusion_check_mul_mat_epi(mm, mode) || add->src[0] != mm || add->type != GGML_TYPE_F32 ||
+        bias->type != GGML_TYPE_F32 || !ggml_is_contiguous(bias) || bias->ne[0] != mm->ne[0] || ggml_nrows(bias) != 1 ||
+        !ggml_metal_fusion_aligned(bias, mode)) {
+        return false;
+    }
+
+    if (fusion->ops.size() == 3) {
+        const ggml_tensor * out = nodes[2];
+        if (out->type != GGML_TYPE_F32 || !ggml_is_contiguous(out) || !ggml_metal_fusion_aligned(out, mode) ||
+            !ggml_metal_fusion_mul_mat_writes_ok(mm, out, mode)) {
+            return false;
+        }
+        if (out->op == GGML_OP_ADD) {
+            const ggml_tensor * res = out->src[0] == add ? out->src[1] : out->src[0];
+            return res != add && res->type == GGML_TYPE_F32 && ggml_is_contiguous(res) && ggml_are_same_shape(res, out) &&
+                   ggml_metal_fusion_aligned(res, mode);
+        }
+        return ggml_get_unary_op(out) == GGML_UNARY_OP_RELU;
+    }
+
+    return ggml_is_contiguous(add) && ggml_metal_fusion_aligned(add, mode) && ggml_metal_fusion_mul_mat_writes_ok(mm, add, mode);
+}
+
+// julia1 patch P9: MUL_MAT + ROPE of a view of its first rows as heads of 64 (neox, positions only). The fused kernel
+// still writes the whole MUL_MAT output (other views of it, e.g. V, read it) and the rotated rows into the ROPE output.
+static bool ggml_metal_fusion_check_mul_mat_rope(
+        const ggml_metal_fusion      * fusion,
+        const ggml_tensor * const    * nodes,
+        const ggml_cgraph            * gf,
+        const int                    * node_idxs,
+              int                      idx,
+              ggml_metal_fusion_mode   mode) {
+    const ggml_tensor * mm   = nodes[0];
+    const ggml_tensor * rope = nodes[1];
+    const ggml_tensor * v    = rope->src[0];
+    const ggml_tensor * pos  = rope->src[1];
+
+    if (rope->op != GGML_OP_ROPE || !ggml_metal_fusion_check_mul_mat_epi(mm, mode)) {
+        return false;
+    }
+
+    const int32_t * params = (const int32_t *) rope->op_params;
+    float freq_scale, ext_factor, attn_factor;
+    memcpy(&freq_scale,  params + 6, sizeof(float));
+    memcpy(&ext_factor,  params + 7, sizeof(float));
+    memcpy(&attn_factor, params + 8, sizeof(float));
+
+    if (params[2] != GGML_ROPE_TYPE_NEOX || params[1] != 64 || params[15] != 0 || freq_scale != 1.0f || ext_factor != 0.0f ||
+        attn_factor != 1.0f || rope->src[2] || rope->type != GGML_TYPE_F32 || !ggml_is_contiguous(rope) ||
+        rope->data == mm->data || !ggml_metal_fusion_aligned(rope, mode) || !ggml_metal_fusion_mul_mat_writes_ok(mm, rope, mode) ||
+        !ggml_metal_fusion_mul_mat_writes_ok(mm, mm, mode)) {
+        return false;
+    }
+
+    // v: the first ne[1]*64 rows of each MUL_MAT column as [64, heads, n, sequences]
+    if (v->op != GGML_OP_VIEW || v->view_src != mm || v->view_offs != 0 || v->type != GGML_TYPE_F32 || v->ne[0] != 64 ||
+        v->nb[1] != 64*sizeof(float) || v->ne[1]*64 > mm->ne[0] || v->nb[2] != mm->nb[1] ||
+        v->nb[3] != v->ne[2]*mm->nb[1] || v->ne[2]*v->ne[3] != mm->ne[1]) {
+        return false;
+    }
+
+    // v is one of the (empty) nodes between the two and only the ROPE reads it
+    int vi = -1;
+    for (int i = node_idxs[idx] + 1; i < node_idxs[idx + 1]; i++) {
+        if (gf->nodes[i] == v) {
+            vi = i;
+        }
+    }
+    if (vi < 0 || ggml_node_get_use_count(gf, vi) != 1) {
+        return false;
+    }
+
+    if (pos->type != GGML_TYPE_I32 || pos->ne[0] < v->ne[2]) {
+        return false;
+    }
+
+    const int outputs[2] = { node_idxs[idx], node_idxs[idx + 1] };
+
+    return ggml_can_fuse_subgraph_ext(gf, node_idxs + idx, 2, fusion->ops.data(), outputs, 2);
+}
