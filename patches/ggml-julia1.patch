+// julia1 patch P3: 1 + erf(x) in single precision vector, as erfc(-x) with erfc from the Chebyshev fit of Numerical
+// Recipes (erfcc, fractional error < 1.2e-7 everywhere), so that GELU keeps its relative precision for negative inputs
+// too
+inline static float32x4_t ggml_v_one_plus_erf(float32x4_t x) {
+    const float32x4_t one = vdupq_n_f32(1.0f);
+    const float32x4_t z = vabsq_f32(x);
+    const float32x4_t t = vdivq_f32(one, vfmaq_f32(one, vdupq_n_f32(0.5f), z));
+    float32x4_t p = vfmaq_f32(vdupq_n_f32(-0.82215223f), vdupq_n_f32(0.17087277f), t);
+    p = vfmaq_f32(vdupq_n_f32(1.48851587f), p, t);
+    p = vfmaq_f32(vdupq_n_f32(-1.13520398f), p, t);
+    p = vfmaq_f32(vdupq_n_f32(0.27886807f), p, t);
+    p = vfmaq_f32(vdupq_n_f32(-0.18628806f), p, t);
+    p = vfmaq_f32(vdupq_n_f32(0.09678418f), p, t);
+    p = vfmaq_f32(vdupq_n_f32(0.37409196f), p, t);
+    p = vfmaq_f32(vdupq_n_f32(1.00002368f), p, t);
+    p = vfmaq_f32(vdupq_n_f32(-1.26551223f), p, t);
+    const float32x4_t erfc = vmulq_f32(t, ggml_v_expf(vfmsq_f32(p, z, z))); // erfc(|x|) = t exp(p - x^2)
+    return vbslq_f32(vcltzq_f32(x), erfc, vsubq_f32(vdupq_n_f32(2.0f), erfc));
+}
+#define GGML_V_ERF_NEON
+
