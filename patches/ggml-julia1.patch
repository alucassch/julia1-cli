+#if defined(GGML_USE_ACCELERATE)
+    // julia1 patch P12: large F32 x F32 matmuls through Accelerate's cblas_sgemm (AMX), selected and called as the BLAS
+    // backend does (contiguous operands, ne0, ne1, ne10 >= 32), so that the CPU backend runs the whole graph alone.
+    // Thread 0 makes the call (Accelerate threads it); the others wait at the next barrier.
+    if (src0->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_F32 && ggml_is_contiguous(src0) && ggml_is_contiguous(src1) &&
+        ne0 >= 32 && ne1 >= 32 && ne10 >= 32) {
+        if (ith == 0) {
+            const int64_t r2 = ne12/ne02;
+            const int64_t r3 = ne13/ne03;
+            for (int64_t i13 = 0; i13 < ne13; i13++) {
+                for (int64_t i12 = 0; i12 < ne12; i12++) {
+                    cblas_sgemm(CblasRowMajor, CblasNoTrans, CblasTrans,
+                                ne1, ne01, ne10,
+                                1.0f, (const float *) ((const char *) src1->data + i12*nb12    + i13*nb13),    ne10,
+                                      (const float *) ((const char *) src0->data + i12/r2*nb02 + i13/r3*nb03), ne00,
+                                0.0f, (float *)       ((char *)       dst->data  + i12*nb2     + i13*nb3),     ne01);
+                }
+            }
+        }
+        return;
+    }
+#endif
