+#ifdef GGML_V_ERF_NEON // julia1 patch P3: 4 lanes at a time instead of scalar erff
+    const float32x4_t half = vdupq_n_f32(0.5f), s = vdupq_n_f32(SQRT_2_INV);
+    for (; i + 3 < n; i += 4) {
+        const float32x4_t xi = vld1q_f32(x + i);
+        const float32x4_t e1 = ggml_v_one_plus_erf(vmulq_f32(xi, s));
+        vst1q_f32(y + i, vmulq_f32(vmulq_f32(vmulq_f32(half, xi), e1), vld1q_f32(g + i)));
+    }
+#endif
+    for (; i < n; ++i) {
         float xi = x[i];
         y[i] = 0.5f * xi * (1.0f + erff(xi*SQRT_2_INV)) * g[i];
     }
