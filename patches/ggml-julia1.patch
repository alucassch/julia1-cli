+// julia1 patch P10: the tiles of kernel_mul_mm_t (kernels/mul_mm.metal instantiates each for F32/F16 weights, fast and
+// p32): nr0 rows of src0 by nr1 columns of src1, K steps of 32; "_pf": register prefetch of the next K step
+struct ggml_metal_mm_tile { const char * name; int16_t nr0, nr1; };
+
+static const ggml_metal_mm_tile ggml_metal_mm_tiles[] = {
+    { "32x16_pf", 32, 16 },
+    { "32x32_pf", 32, 32 },
+    { "48x32",    48, 32 },
+};
+
+// julia1 patch P10: the kernel_mul_mm_t tile for this matmul, or nullptr for the stock kernel_mul_mm (64x32 tiles). With
+// few stock threadgroups most of the GPU idles, and smaller tiles (the smallest also with register prefetch) finish
+// sooner: up to 12 stock threadgroups 32x16 prefetch, up to 24 32x32 prefetch, up to 36 48x32, more: stock.
+static const ggml_metal_mm_tile * ggml_metal_mm_pick_tile(const ggml_tensor * op, int epi) {
+    if ((op->src[0]->type != GGML_TYPE_F32 && op->src[0]->type != GGML_TYPE_F16) || op->src[1]->type != GGML_TYPE_F32) {
+        return nullptr;
+    }
+
+    const int64_t n = ((op->ne[0] + 63)/64)*((op->ne[1] + 31)/32)*op->ne[2]*op->ne[3];
+    const ggml_metal_mm_tile * t = n <= 12 ? &ggml_metal_mm_tiles[0] : n <= 24 ? &ggml_metal_mm_tiles[1] : n <= 36 ? &ggml_metal_mm_tiles[2] : nullptr;
+
+    // no bounds checks in kernel_mul_mm_t; the ROPE epilogue rotates whole heads of 64 rows within a tile
+    if (!t || op->src[0]->ne[0] % 32 != 0 || op->ne[0] % t->nr0 != 0 || op->ne[1] % t->nr1 != 0 ||
+        ((epi & MM_EPI_ROPE) && t->nr0 % 64 != 0)) {
+        return nullptr;
+    }
+
+    return t;
+}
